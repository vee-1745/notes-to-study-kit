# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Gemma 4 model on the Gemini API. Options: gemma-4-26b-a4b-it (faster), gemma-4-31b-it (higher quality)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Requests per minute per IP (protects your key on a public demo)
RATE_LIMIT_PER_MIN=6
